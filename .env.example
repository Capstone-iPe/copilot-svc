# Copy to .env and fill in keys. .env is gitignored.

CHAT_API_KEY=
CHAT_BASE_URL=https://103.42.50.41:1032/v1
CHAT_CA_CERT=vm06-ca.crt
CHAT_MODEL=Qwen/Qwen3-8B

ONB_MCP_URL=https://onb-k8ud.onrender.com/mcp

# onb-corpus search API (same CORPUS_API_KEY as that service).
CORPUS_SEARCH_URL=https://onb-corpus.onrender.com
CORPUS_API_KEY=

# CA file is gitignored. Local: place vm06-ca.crt at repo root.
# Render: secret file + CHAT_CA_CERT=/etc/secrets/vm06-ca.crt
# Required by the FastAPI service. Use a shared Render PostgreSQL connection string;
# prefer Render's internal URL or a session-mode pooler (not transaction pooling).
# Example format only: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Required: Google OAuth web client ID used by the sign-in flow.
# Usually ends in .apps.googleusercontent.com. Do not put the client secret here.
GOOGLE_CLIENT_ID=

# Optional comma-separated additional Google OAuth client IDs accepted by Copilot.
# GOOGLE_ALLOWED_AUDIENCES=another-client-id.apps.googleusercontent.com
